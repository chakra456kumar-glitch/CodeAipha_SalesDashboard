    <dashboard name='Story ' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#76b7b2' fontname='Times New Roman' italic='false'>SALES PERFORMANCE ANALYSIS STORY</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#eff3e3' />
        </style-rule>
        <style-rule element='story-description'>
          <format attr='background-color' value='#f2f2f2d9' />
        </style-rule>
        <style-rule element='story-point-caption'>
          <format attr='width' value='676' />
          <format attr='font-family' value='Tableau Medium' />
          <format attr='font-size' value='10' />
          <format attr='background-color' value='#edc948' />
        </style-rule>
        <style-rule element='story-title'>
          <format attr='font-style' value='italic' />
          <format attr='text-decoration' value='underline' />
          <format attr='font-weight' value='bold' />
          <format attr='font-size' value='36' />
          <format attr='color' value='#0055ff' />
          <format attr='font-family' value='Tw Cen MT Condensed Extra Bold' />
          <format attr='text-align' value='center' />
        </style-rule>
      </style>
      <size maxheight='764' maxwidth='1316' minheight='764' minwidth='1316' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97906' id='1' param='vert' removable='false' type-v2='layout-flow' w='98784' x='608' y='1047'>
            <zone h='8770' id='3' type-v2='title' w='98784' x='608' y='1047' />
            <zone fixed-size='175' h='22906' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98784' x='608' y='9817' />
            <zone h='66230' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98784' x='608' y='32723'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='The Technology category emerged as the best-selling category with the highest overall sales contribution. Office Supplies showed moderate performance, while Furniture generated comparatively lower sales. This indicates strong customer demand for technology-related products and highlights potential growth opportunities in the Furniture segment.' captured-sheet='SALES BY CATEGORY' id='1' />
                  <story-point caption='The monthly sales trend remained relatively stable throughout the year, maintaining consistent performance with only minor fluctuations. Sales showed slight growth during April, June, September, and December, while small dips were observed in August and November. The overall steady sales pattern indicates balanced customer demand and stable business performance across all months.' captured-sheet='MONTHLY SALES GROWTH ' id='2' />
                  <story-point caption='The regional profit analysis reveals that the East region generated the highest overall profit, followed closely by the West and Centre regions. In contrast, the South region recorded the lowest profit contribution among all regions. The distribution indicates stronger business performance and customer engagement in the East region, while the South region presents opportunities for future growth and improvement.' captured-sheet='PROFIT BY REGION' id='3' />
                  <story-point caption='The regional sales analysis reveals that the South and Central regions are the major contributors to the total quantity sold. The East region also shows strong performance with sales concentrated in key markets, while the West region presents potential opportunities for future growth and market expansion.' captured-sheet='QUANTITY SOLD BY REGION' id='4' />
                  <story-point caption='The KPI analysis reveals that the company is performing strongly across all major business metrics. High sales revenue combined with substantial profit and quantity sold demonstrates overall business stability, operational success, and future growth potential' captured-sheet='SALES KPI ' id='5' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{B528BFAD-C116-4A7F-93D3-3D6A8889883A}' />
    </dashboard>
